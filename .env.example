# Copy this file to .env.local and fill in real values. Never commit .env.local
# — it's already gitignored (see `.env*` in .gitignore).

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# Project Settings -> API -> Project URL
SUPABASE_URL=

# Supabase service_role key (NOT the anon/public key). This key bypasses Row
# Level Security and must only ever be used server-side — it is read only by
# lib/supabase/admin.ts, which is guarded with `server-only` so it can never
# end up in a client bundle. Do NOT prefix this with NEXT_PUBLIC_.
# Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Random long secret used to HMAC-hash visitor IPs before they're stored, for
# the /api/waitlist rate limiter. Generate one with:
#   openssl rand -hex 32
RATE_LIMIT_SALT=
